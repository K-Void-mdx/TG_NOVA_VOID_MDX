# NOVA_VOID MDX — Telegram control plane
# Copy to `.env` and fill in real values. `.env` is git-ignored and is NEVER
# committed. Keep every token secret.

# ── Telegram (required — nothing starts without the bot token) ──────────────
TELEGRAM_BOT_TOKEN=
# Numeric Telegram user id that administers every WhatsApp session (gate-exempt).
TELEGRAM_OWNER_ID=8845366023
# Channel / group the membership gate requires users to join.
TELEGRAM_CHANNEL=@nova_void_updates77
TELEGRAM_GROUP=@nova_void_mdx_com77
# Optional t.me link on the owner button of Telegram cards.
TELEGRAM_OWNER_LINK=

# ── Identity ────────────────────────────────────────────────────────────────
BOT_NAME=NOVA_VOID MDX
BOT_USERNAME=@nova_void_mdx_bot
PREFIX=.

# ── Operator / owner card (WhatsApp `.owner` vCard) ─────────────────────────
# OWNER_NUMBER is the public number shown on the `.owner` vCard. It does NOT
# grant any authority; authority comes from OWNER_JIDS / TELEGRAM_OWNER_ID.
OWNER_NAME=King Val
OWNER_NUMBER=2347046855205
OWNER_BIO=Owner & developer of NOVA_VOID MDX.

# ── WhatsApp authority (optional, in addition to TELEGRAM_OWNER_ID) ─────────
# Comma-separated full numbers (with country code, digits only). These grant
# owner role to commands typed on WhatsApp.
OWNER_JIDS=2347046855205@s.whatsapp.net
SUDO_JIDS=

# ── AI providers (any subset; failover Gemini → Groq → OpenCode Zen → OpenRouter) ──
GEMINI_API_KEY=
GROQ_API_KEY=
OPENCODE_API_KEY=
OPENROUTER_API_KEY=

# ── Runtime ─────────────────────────────────────────────────────────────────
# Default ./data (git-ignored). Sessions live under <DATA_DIR>/sessions.
DATA_DIR=./data
AI_MAX_HISTORY=40
DEBUG_MESSAGES=false